# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your_flask_secret_key_here
PORT=5000

# Database Settings (Uses local SQLite by default)
DATABASE_URL=sqlite:///smartcapture.db

# CORS Settings
# Set this to your deployed Vercel frontend domain(s)
# E.g., FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# AI Configuration (Optional, local offline parser runs by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
